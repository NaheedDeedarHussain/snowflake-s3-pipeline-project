# AWS
AWS_REGION=us-east-1
S3_BUCKET=replace-with-globally-unique-bucket-name
AWS_PROFILE=default

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=PIPELINE_WH
SNOWFLAKE_DATABASE=PIPELINE_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_STAGE=PIPELINE_S3_STAGE
SNOWFLAKE_STORAGE_INTEGRATION=PIPELINE_S3_INTEGRATION
SNOWFLAKE_S3_PREFIX=s3://replace-with-bucket/raw/

# Local services
JUPYTER_TOKEN=change-this-token
NIFI_USERNAME=admin
NIFI_PASSWORD=ChangeThisPassword123!
